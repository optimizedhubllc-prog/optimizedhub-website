<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/png" href="https://raw.githubusercontent.com/optimizedhubllc-prog/optimized-hub-assets/main/OH_Logo_Dark%20(2).png">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Privacy Policy — Optimized Hub</title>
<meta name="description" content="Privacy Policy for Optimized Hub Media LLC's Database Reactivation service.">
<style>
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap');

  :root {
    --cobalt: #2563EB;
    --cobalt-mid: #3B82F6;
    --copper: #C17B3C;
    --copper-light: #D4933F;
    --ink: #111827;
    --ink-bg: #0B0F1A;
    --ink-card: #151B29;
    --pearl: #F8FAFC;
    --pearl-dim: #E5EAF0;
    --muted: #9CA3AF;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { font-family: 'Inter', sans-serif; background: var(--ink-bg); color: var(--pearl); }

  header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 24px 40px;
    background: var(--ink-bg);
    border-bottom: 1px solid rgba(248,250,252,0.06);
    position: sticky; top: 0; z-index: 50;
  }
  .logo { display: flex; align-items: center; gap: 10px; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 16px; letter-spacing: 0.05em; text-decoration: none; color: var(--pearl); }
  .logo-mark { display: none; }
  .logo img { width: 30px; height: 30px; border-radius: 8px; border: 1px solid rgba(96,165,250,0.4); }
  nav { display: flex; gap: 32px; align-items: center; }
  nav a { color: var(--muted); text-decoration: none; font-size: 14px; font-weight: 500; }
  nav a:hover { color: var(--pearl); }
  .nav-cta { background: var(--cobalt); color: var(--pearl) !important; padding: 10px 20px; border-radius: 8px; font-weight: 700; }

  section { padding: 90px 24px; max-width: 1100px; margin: 0 auto; }

  .eyebrow {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 12px; font-weight: 700; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--copper-light);
    margin-bottom: 14px;
  }

  h1, h2 {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 800; line-height: 1.15;
  }

  .hero { text-align: center; padding-top: 80px; }
  .hero .tag { font-size: 12px; font-weight: 700; letter-spacing: 0.16em; color: var(--copper-light); text-transform: uppercase; margin-bottom: 20px; }
  .hero h1 { font-size: 52px; max-width: 850px; margin: 0 auto 28px; }
  .hero h1 .accent { color: var(--copper-light); }
  .hero .sub { font-size: 17px; color: var(--muted); max-width: 620px; margin: 0 auto 40px; line-height: 1.7; }
  .cta-button {
    display: inline-block; background: var(--cobalt); color: var(--pearl);
    font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; font-size: 15px;
    padding: 16px 36px; border-radius: 8px; text-decoration: none;
  }
  .hero-stats { display: flex; justify-content: center; gap: 80px; margin-top: 70px; }
  .hero-stat .num { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 34px; font-weight: 800; color: var(--copper-light); }
  .hero-stat .label { font-size: 13px; color: var(--muted); margin-top: 6px; }

  section h2 { font-size: 38px; margin-bottom: 18px; max-width: 700px; }
  .subhead { font-size: 16px; color: var(--muted); line-height: 1.6; max-width: 560px; margin-bottom: 48px; }

  .offer-card {
    background: var(--ink); border: 1px solid rgba(37,99,235,0.25);
    border-radius: 16px; padding: 48px 44px; text-align: left; max-width: 640px;
  }
  .offer-card .card-eyebrow { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--cobalt-mid); margin-bottom: 10px; }
  .offer-card h3 { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 28px; font-weight: 700; margin-bottom: 14px; }
  .offer-card .desc { font-size: 15px; color: var(--muted); line-height: 1.65; margin-bottom: 32px; max-width: 480px; }
  .price-row { display: flex; align-items: baseline; gap: 10px; margin-bottom: 6px; }
  .price { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 48px; font-weight: 800; color: var(--pearl); }
  .price-unit { font-size: 16px; color: var(--muted); }
  .no-setup { font-size: 13px; color: var(--copper-light); font-weight: 600; margin-bottom: 32px; }
  .features { list-style: none; margin-bottom: 40px; border-top: 1px solid rgba(248,250,252,0.08); padding-top: 28px; }
  .features li { display: flex; align-items: flex-start; gap: 12px; font-size: 15px; color: var(--pearl-dim); padding: 9px 0; }
  .features li svg { flex-shrink: 0; margin-top: 3px; }
  .cta-micro { display: block; margin-top: 14px; font-size: 13px; color: var(--muted); }
  .secondary-link-wrap { margin-top: 24px; padding-top: 20px; border-top: 1px solid rgba(248,250,252,0.08); }
  .secondary-link-wrap a { font-size: 14px; color: var(--muted); text-decoration: underline; }

  .who-card { background: var(--ink); border: 1px solid rgba(37,99,235,0.2); border-radius: 16px; padding: 44px; max-width: 640px; }
  .who-icon { width: 52px; height: 52px; background: rgba(37,99,235,0.12); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; margin-bottom: 20px; }
  .who-card h3 { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 24px; font-weight: 700; margin-bottom: 12px; }
  .who-card p { color: var(--muted); font-size: 15px; line-height: 1.65; margin-bottom: 24px; }
  .who-card ul { list-style: none; }
  .who-card li { display: flex; align-items: flex-start; gap: 12px; font-size: 15px; color: var(--pearl-dim); padding: 8px 0; }
  .who-card li svg { flex-shrink: 0; margin-top: 3px; }

  .cost-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .cost-card { background: var(--ink-card); border-radius: 14px; padding: 32px; }
  .cost-card .stat { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 40px; font-weight: 800; color: var(--copper-light); margin-bottom: 8px; }
  .cost-card .label { font-weight: 700; font-size: 15px; margin-bottom: 10px; }
  .cost-card .desc { font-size: 14px; color: var(--muted); line-height: 1.6; }

  .process-row { display: flex; justify-content: space-between; margin-top: 60px; }
  .process-step { flex: 1; text-align: center; padding: 0 16px; }
  .step-circle { width: 56px; height: 56px; border-radius: 50%; border: 2px solid var(--cobalt-mid);  display: flex; align-items: center; justify-content: center; fontfamily: 'Plus Jakarta Sans', sans-serif; font-weight: 700; font-size: 18px; color: var(--cobalt-mid); margin: 0 auto 20px; }
  .process-step h3 { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 17px; margin-bottom: 10px; }
  .process-step p { font-size: 14px; color: var(--muted); line-height: 1.6; }

  .calc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 32px; }
  .field label { display: block; font-size: 14px; font-weight: 600; margin-bottom: 10px; }
  .field input { width: 100%; background: var(--ink-card); border: 1px solid rgba(248,250,252,0.1); border-radius: 8px; padding: 14px 16px; color: var(--pearl); font-size: 15px; font-family: 'Inter', sans-serif; }
  .field input:focus { outline: none; border-color: var(--cobalt-mid); }
  .calc-note { font-size: 12px; color: var(--muted); margin-top: 8px; }
  .results-box { background: var(--ink-card); border-radius: 14px; padding: 32px; }
  .results-box .eyebrow { margin-bottom: 20px; }
  .results-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-bottom: 24px; }
  .result-card { background: var(--ink); border-radius: 10px; padding: 20px; }
  .result-card .r-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 8px; }
  .result-card .r-value { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 26px; font-weight: 800; }
  .result-card.copper .r-value { color: var(--copper-light); }
  .result-card.cobalt .r-value { color: var(--cobalt-mid); }
  .result-card.green .r-value { color: #34D399; }
  .results-summary { font-size: 14px; color: var(--pearl-dim); line-height: 1.7; background: rgba(37,99,235,0.07); border: 1px solid rgba(37,99,235,0.2); border-radius: 10px; padding: 18px 20px; }

  /* FAQ */
  .faq-category { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 13px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--cobalt-mid); margin: 40px 0 16px; }
  .faq--ite { background: var(--ink-card); border-radius: 12px; margin-bottom: 12px; overflow: hidden; }
  .faq-q { width: 100%; background: none; border: none; color: var(--pearl); font-family: 'Inter', sans-serif; font-weight: 700; font-size: 16px; text-align: left; padding: 22px 24px; cursor: poienter;display: flex; justify-content: space-between; align-items: center; }
  .faq-q .plus { color: var(--muted); font-size: 20px; transition: transform 0.2s; flex-shrink: 0; margin-left: 16px; }
  .faq--ite.open .plus { transform: rotate(45deg); }
  .faq-a { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; padding: 0 24px; }
  .faq--ite.open .faq-a { max-height: 400px; padding: 0 24px 22px; }
  .faq-a p { color: var(--muted); font-size: 14px; line-height: 1.65; }

  /* LEGAL (Terms / Privacy) */
  .legal-page { max-width: 780px; }
  .legal-page h2.legal-title { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 36px; font-weight: 800; margin-bottom: 8px; max-width: none; }
  .legal-page .updated { font-size: 13px; color: var(--muted); margin-bottom: 30px; }
  .legal-page .notice { background: rgba(212,147,63,0.08); border: 1px solid rgba(212,147,63,0.25); border-radius: 10px; padding: 18px 22px; font-size: 14px; color: var(--muted); margin-bottom: 40px; line-height: 1.6; }
  .legal-page h3 { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 19px; font-weight: 700; margin: 30px 0 10px; color: var(--pearl); }
  .legal-page p, .legal-page li { font-size: 14.5px; color: #C9CFD9; margin-bottom: 12px; line-height: 1.7; }
  .legal-page ul { padding-left: 22px; margin-bottom: 12px; }
  .legal-page a { color: #3B82F6; }
  .back-to-top { display: inline-block; margin-top: 30px; font-size: 13px; color: var(--muted); text-decoration: none; }

  footer { text-align: center; padding: 40px 24px; border-top: 1px solid rgba(248,250,252,0.06); }
  footer .links { display: flex; justify-content: center; gap: 24px; margin-bottom: 16px; }
  footer .links a { color: var(--muted); text-decoration: none; font-size: 13px; }
  footer .copy { font-size: 12px; color: var(--muted); }

  @media (max-width: 800px) {
    header { flex-direction: column; gap: 16px; }
    nav { flex-wrap: wrap; justify-content: center; gap: 16px; }
    .hero h1 { font-size: 34px; }
    .hero-stats { flex-direction: column; gap: 24px; }
    .cost-grid, .calc-grid, .results-grid { grid-template-columns: 1fr; }
    .process-row { flex-direction: column; gap: 40px; }
  }
</style>
</head>

